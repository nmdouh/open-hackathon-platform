# Copy to .env and adjust. Never commit a real .env file.

# Password for the bundled PostgreSQL when using docker compose.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# PostgreSQL connection string (required when not using docker compose).
DATABASE_URL=postgres://ohp:ohp@localhost:5432/ohp

# HTTP port the API and web UI listen on.
PORT=3000

# Display name of your deployment (shown in the UI).
APP_NAME=Open Hackathon Platform

# Allow people to create their own accounts (set false when using SSO only).
ALLOW_SIGNUP=true

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Set to 1 (or a hop count) when running behind a reverse proxy / load balancer.
TRUST_PROXY=0

# Rate limit for sign-in and sign-up attempts per IP (and per email) per window.
AUTH_RATE_LIMIT=20

# --- Optional AI coach -------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. Leave LLM_ENDPOINT empty to
# switch the AI coach off. The key stays on the server and is never sent to browsers.
#   Hosted:  https://api.openai.com/v1/chat/completions
#   Local:   http://localhost:11434/v1/chat/completions   (Ollama)
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
# AI coach requests allowed per person per 24 hours.
LLM_DAILY_LIMIT=20
